{
  "title": "Serverless LLM DevOps Dashboard",
  "uid": "serverless-llm-devops",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{path=\"/chat\"}[1m]))",
          "legendFormat": "chat rps",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 Inference Latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(inference_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latency",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active Pods / Replica Count",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{deployment=\"serverless-llm\"}",
          "legendFormat": "replicas",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jenkins Build Result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jenkins_builds_last_build_result",
          "legendFormat": "last build result",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "KEDA Scale Events",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(keda_scaler_metrics_value[1m]))",
          "legendFormat": "keda scaler metric value",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-30m", "to": "now" }
}
